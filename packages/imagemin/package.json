{
  "name": "imagemin-rs",
  "version": "0.1.0-rc.0",
  "description": "An imagemin-compatible image optimization pipeline powered by Rust and napi-rs.",
  "keywords": [
    "image",
    "imagemin",
    "napi",
    "optimization",
    "rust"
  ],
  "homepage": "https://github.com/ntnyq/imagemin-rs#readme",
  "bugs": {
    "url": "https://github.com/ntnyq/imagemin-rs/issues"
  },
  "license": "MIT",
  "author": {
    "name": "ntnyq"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntnyq/imagemin-rs.git"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cwebp-bin": "8.0.0",
    "gifsicle": "5.3.0",
    "globby": "catalog:",
    "image-dimensions": "catalog:",
    "is-svg": "catalog:",
    "jpegtran-bin": "7.0.0",
    "junk": "catalog:",
    "mozjpeg": "8.0.0",
    "pngquant-bin": "9.0.0",
    "sharp": "0.35.3",
    "svgo": "catalog:"
  },
  "devDependencies": {
    "@ntnyq/tsconfig": "catalog:",
    "@types/node": "catalog:",
    "imagemin": "9.0.1",
    "imagemin-avif": "0.1.6",
    "imagemin-gifsicle": "7.0.0",
    "imagemin-jpegtran": "8.0.0",
    "imagemin-mozjpeg": "10.0.0",
    "imagemin-optipng": "8.0.0",
    "imagemin-pngquant": "10.0.0",
    "imagemin-svgo": "12.0.0",
    "imagemin-webp": "8.0.0",
    "jpeg-js": "0.4.4",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "optionalDependencies": {
    "@imagemin-rs/binding": "workspace:*"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
